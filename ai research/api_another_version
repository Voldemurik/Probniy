@app.get("/health")
def health():
    return {"status": "ok", "version": "1.3.2"}


@app.post("/api/v1/analyze", response_model=AnalyzeResponse)
async def analyze(file: UploadFile = File(...)):
    if not file.filename:
        raise HTTPException(status_code=400, detail="Файл не указан")
    if not file.filename.lower().endswith(".csv"):
        raise HTTPException(status_code=400, detail="Поддерживаются только CSV-файлы")

    content = await file.read()
    if len(content) > MAX_FILE_SIZE:
        raise HTTPException(status_code=413, detail="Файл слишком большой (макс 10 МБ)")

    df = parse_csv(content)
    df = prepare_transactions(df)
    subscriptions = analyze_transactions(df)

    total_monthly = round(sum(sub.monthly_cost for sub in subscriptions), 2)

    return AnalyzeResponse(
        subscriptions=subscriptions,
        total_monthly_savings_potential=total_monthly,
    )


