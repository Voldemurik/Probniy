               ИЗМЕНЕНО:
               НАЖАТИЕ НА ПРЕДЛОЖЕНИЕ
               СРАЗУ ОТПРАВЛЯЕТ ЕГО БОТУ
               ===================================================== */

            suggestionButtons.forEach(button => {

                button.addEventListener(
                    'click',
                    () => {

                        /*
                         * Берём текст предложения
                         * и вставляем его в поле ввода.
                         */

                        input.value =
                            button.textContent.trim();


                        /*
                         * СРАЗУ ОТПРАВЛЯЕМ СООБЩЕНИЕ.
                         */

                        handleSend();

                    }
                );

            });