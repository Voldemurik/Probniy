.suggestions {
            display: flex;
            gap: 8px;
            padding: 10px 16px 4px;
            background: #ffffff;
            overflow-x: auto;
            flex-shrink: 0;
            scrollbar-width: none;
        }

        .suggestions::-webkit-scrollbar {
            display: none;
        }


        /* ----- Кнопки предложений ----- */

        .suggestion-btn {
            flex-shrink: 0;

            padding: 9px 14px;

            border: 1px solid #d8e0e6;
            border-radius: 18px;

            background: #f5f7f9;
            color: #222222;

            font-size: 14px;
            font-weight: 500;

            cursor: pointer;

            transition:
                background 0.2s,
                border-color 0.2s,
                color 0.2s,
                transform 0.1s;
        }

        .suggestion-btn:hover {
            background: #e9f5fb;
            border-color: #0088cc;
            color: #0088cc;
        }

        .suggestion-btn:active {
            transform: scale(0.97);
        }
